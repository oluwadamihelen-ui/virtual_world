# Copy to .env (never commit .env). Windows CMD: copy .env.example .env
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://mvw:mvw_dev_password@localhost:5432/mvw_dev
# Test database used by `npm test` (it is wiped between tests!)
TEST_DATABASE_URL=postgres://mvw:mvw_dev_password@localhost:5432/mvw_test
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-change-me-change-me-change-me
# Shared secret held ONLY by the dedicated game server. Never ship to clients.
SERVER_API_KEY=change-me-server-key-change-me-0000
GAME_DATA_DIR=../game-data

# Optional: separate key for encrypting direct messages at rest (32+ chars). Back it up! Falls back to a key derived from JWT_SECRET.
# MESSAGE_KEY=

# Voice chat (optional). JSON array of WebRTC ICE servers. Without it the game uses a public STUN server, which is fine on one network but
# not for players behind strict firewalls: those need a TURN server (for example coturn). Keep TURN credentials here, never in git.
# VOICE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"secret"}]
